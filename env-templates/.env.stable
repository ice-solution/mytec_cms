# MyTEC CMS Stable Version 環境配置
# 穩定版本配置

# 應用程式設定
NODE_ENV=production
PORT=3000

# 資料庫設定
MONGODB_URI=mongodb://localhost:27017/mytec_cms_stable

# JWT 設定
JWT_SECRET=mytec_stable_secret_2024

# Stripe 設定
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# 郵件設定
EMAIL_USER=admin@mytec-cms.com
EMAIL_PASS=your_email_password

# 前端 API URL
REACT_APP_API_URL=https://mytec-cms.sth-tech.com
REACT_APP_ENV=production
PUBLIC_URL=/

# 默認管理員配置
ADMIN_EMAIL=admin@mytec-cms.com
ADMIN_PASSWORD=mytec_stable_admin_2024
ADMIN_FIRST_NAME=MyTEC
ADMIN_LAST_NAME=Admin
