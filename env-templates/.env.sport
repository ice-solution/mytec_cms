# MyTEC CMS Sport Version 環境配置
# 運動版本配置

# 應用程式設定
NODE_ENV=production
PORT=3001

# 資料庫設定
MONGODB_URI=mongodb://localhost:27017/mytec_cms_sport

# JWT 設定
JWT_SECRET=mytec_sport_secret_2024

# Stripe 設定
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# 郵件設定
EMAIL_USER=sport@mytec-cms.com
EMAIL_PASS=your_email_password

# 前端 API URL
REACT_APP_API_URL=https://sport.mytec-cms.sth-tech.com
REACT_APP_ENV=production
PUBLIC_URL=/

# 默認管理員配置
ADMIN_EMAIL=sport@mytec-cms.com
ADMIN_PASSWORD=mytec_sport_admin_2024
ADMIN_FIRST_NAME=MyTEC
ADMIN_LAST_NAME=Sport
